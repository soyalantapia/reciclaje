# Mock Service Worker. En "false" desactiva el backend mock (para enchufar
# un backend real). Por defecto (sin definir) MSW está ON.
VITE_USE_MSW=true

# Escenario de la demo. Sin la variable: la demo general (la publicada).
# "club": el caso de un club para el piloto (también con `npm run dev:club`).
# VITE_ESCENARIO=club

# Nombre, estadio y sede del club en el escenario club. Sin la variable, el club es Talleres
# (decidido el 10/10/2026); sirve para mostrarle la demo a otro club. Con otro nombre no aparece nada de
# Talleres; su escudo y su azul se muestran desde el 12/10/2026 (decisión de Alan para la reunión).
# VITE_CLUB_NOMBRE=Talleres
# VITE_CLUB_ESTADIO=Estadio
# VITE_CLUB_SEDE=Sede social
